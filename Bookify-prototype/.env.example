# Copy this file to .env and fill it in. .env is git-ignored — never commit it.

# ── Local MySQL (MySQL Workbench / the MySQL service on your PC) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bookify

# Time zone MySQL uses for NOW() — Thailand is +07:00
DB_TIMEZONE=+07:00

# ── Cloud MySQL (e.g. Aiven): use the values from the provider's dashboard ──
# DB_HOST=mysql-bookify-yourname.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=...
# DB_NAME=bookify            # db:setup creates it for you
# DB_SSL=true
# DB_SSL_CA=./ca.pem          # path to the CA certificate you downloaded,
#                             # or paste the whole certificate text here

PORT=3000

# ── Admin login (unlocks the Manage and Admin tabs and their API routes) ──
# Set these in .env (and in your host's dashboard when you deploy). If either
# is missing, admin login is turned off.
ADMIN_EMAIL=admin@Bookify.com
ADMIN_PASSWORD=99179179
# Optional: a long random string that signs login sessions. Without it one is
# derived from the admin password, so changing the password logs everyone out.
# SESSION_SECRET=
